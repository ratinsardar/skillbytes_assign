{
  "name": "practice_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run client\"",
    "client": "vite --host 0.0.0.0",
    "backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "seed": "python -m backend.seed",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
